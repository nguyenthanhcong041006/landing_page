<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.css">
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
<script>
$(function() {
	// スライダー
	$('.top-slider-list').slick({
		autoplay: true,
		autoplaySpeed: 0,
		speed: 30000,
		cssEase: "linear",
		slidesToShow: 3,
		swipe: false,
		arrows: false,
		pauseOnFocus: false,
		pauseOnHover: false,
		responsive: [
			{
				breakpoint: 480,
				settings: {
					slidesToShow: 2,
					speed: 20000,
				}
			},
		]
	});
});
$(window).on('load',function(){
	// PLAYボタン
	$('.play-btn').on('click', function(){
		if($(this).hasClass('active')){
			$('.video-ht').get(0).pause();
		}else{
			$('.video-ht').get(0).play();
		}
	});
	$('.video-ht').on('playing', function(){
		$('.play-btn').addClass('active'); 
		$(this).attr('controls', '');
	});
	$(".video-ht").on('pause', function(){
		$('.play-btn').removeClass('active');
		$(this).removeAttr('controls');
	});
	$('.video-ht').on('ended', function(){ 
		$('.play-btn').removeClass('active');
		$(this).removeAttr('controls');
	});
	var scroll;
	var objTop    = $('.hero-btm').offset().top;
	var objFot    = $('footer').offset().top;
	var objHei    = $('footer').innerHeight() - 100;
	var winHeight = $(window).height();
	$(window).on('scroll', function(){
		scroll = $(window).scrollTop();
		if(scroll >= objTop){
			$('.menu-btn').addClass('bk');
			$('.contact-fixed').addClass('up');
		}
		else {
			$('.menu-btn').removeClass('bk');
			$('.contact-fixed').removeClass('up');
		}
		if(scroll > objFot - winHeight + objHei ){
			$('.contact-fixed').addClass('up-add');
		}
		else {
			$('.contact-fixed').removeClass('up-add');
		}
	});
	//
	//	モーダル
	//
	$('.mopen').click(function(){
		var idName = $(this).data("modal");
		$("body").addClass("overflow-hidden");
		$(".modal-overlay-" + idName).addClass("open modal-overlay-over");
		slickItem(idName);
	});
	$('.mclose').click(function(){
		$("body").removeClass("overflow-hidden");
		$(this).parent().parent(".modal-overlay").removeClass("open modal-overlay-over");
		$('.md-item-slider').slick('unslick');
	});
	function slickItem(slist) {
		var sslider = ".md-item-slider-" + slist;
		$(sslider).slick({
			arrows:true,
			autoplay:false,
			dots:false,
			infinite: false,
			slidesToShow: 1,
			slidesToScroll: 1,
			centerMode: true,
			centerPadding: '25%',
			prevArrow: '<img src="https://foxxchair.jp/wp-content/themes/wp-foxx/assets/images/svg/slider_prev.svg" class="prev-arrow">',
			nextArrow: '<img src="https://foxxchair.jp/wp-content/themes/wp-foxx/assets/images/svg/slider_next.svg" class="next-arrow">',
			responsive: [{
				breakpoint: 767,
				settings: {
					centerMode: false,
					centerPadding: '0px',
				}
			}]
		});
	}
});
</script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.7.0/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.7.0/dist/ScrollTrigger.min.js"></script>
<script>
$(window).on('load',function(){
	let fadeListA = ['.fu01','.fu03','.fu04','.fu05','.fu06','.fu07','.fu08','.fu09','.fu10','.fu11','.fu12'];
	$.each(fadeListA, function(index, value){
		gsap.fromTo(value, { autoAlpha:0, y:40},{ delay:0, duration:0.5, autoAlpha:1, y:0, ease: "circ.out",
			scrollTrigger: { trigger: value, start: 'top 80%', once: true, }
		});
	});
	let fadeListB = ['.fu02'];
	$.each(fadeListB, function(index, value){
		gsap.fromTo(value, { autoAlpha:0, y:40},{ delay:.75, duration:0.5, autoAlpha:1, y:0, ease: "circ.out",
			scrollTrigger: { trigger: value, start: 'top 80%', once: true, }
		});
	});
});
</script>


